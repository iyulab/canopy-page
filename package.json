{
  "name": "@iyulab/canopy-page",
  "version": "0.23.3",
  "description": "Authoring pipeline for markdown sites — documentation, blogs and release logs: one settings file, integrity checks, and a build.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "documentation",
    "static-site-generator",
    "markdown",
    "docs",
    "blog",
    "canopy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iyulab/canopy-page.git"
  },
  "bugs": {
    "url": "https://github.com/iyulab/canopy-page/issues"
  },
  "homepage": "https://iyulab.github.io/canopy-page",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "canopy-page": "./dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "biome lint ./src",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@iyulab/declart": "^0.21.0",
    "@types/node": "^26.6.3",
    "playwright": "^1.63.0",
    "rehype-declart": "^0.21.0",
    "rehype-mermaid": "^3.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@iyulab/canopy": "^0.23.0",
    "chokidar": "^5.0.0"
  }
}
